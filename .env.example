# ============================================================
# testgen 環境變數範本（複製為 .env 使用；.env 已在 .gitignore）
# 全部可留空 — 有預設值或由 agent .md 決定
# ============================================================

# runner：opencode（預設）| qwen（需 npm i -D @qwen-code/sdk）
#UT_RUNNER=opencode

# 模型（留空 = 用 .opencode/agent/*.md 的 model 欄位；格式 provider/model）
#UT_WRITER_MODEL=vllm/qwen3-coder
#UT_REVIEWER_MODEL=anthropic/claude-sonnet-4-6
# 兩者都沒設時，writer 退回吃 UT_MODEL
#UT_MODEL=

# 迭代與門檻
#UT_MAX_ITER=5
# 目標是資料夾時每批幾個類別；每批各自跑完整的迴圈，沒通過的批次撤回變更、不影響其他批次。
#UT_BATCH_SIZE=1
#UT_MIN_LINE_COV=80
#UT_MIN_BRANCH_COV=70
# 1 = 找不到 JaCoCo 報告時 coverage gate 直接 FAIL
#UT_STRICT_COV=1
# 1 = 允許「編譯成功但 0 個測試執行」通過 build gate（預設 fail-closed 擋下）
#UT_ALLOW_ZERO_TESTS=1
# 1 = 跳過預檢基準建置（省一次 build，但無法區分既有紅燈與 writer 造成的失敗）
#UT_SKIP_BASELINE=1
# 0 = 預檢紅燈時直接中止，不進修復迴圈（預設會先修既有紅燈再產生）
#UT_REPAIR_BASELINE=0
# 修復迴圈最大輪數
#UT_REPAIR_MAX_ITER=5
# 連續幾輪紅燈數沒下降就放棄修復（stuck 只抓得到完全相同的報告，這個抓得到「修A壞B」）
#UT_REPAIR_NO_PROGRESS_ROUNDS=2
# 1 = 修復失敗（或關閉修復）時照樣執行（預設中止）。既有紅燈標記為 pre-existing，
# 且 build gate 改判「本輪失敗集合 ⊆ 預檢基準」——既有失敗可續紅，新弄壞的照樣擋。
# 與 UT_SKIP_BASELINE 互斥：沒有預檢就沒有基準可扣除，並用會直接中止。
#UT_ALLOW_DIRTY_BASELINE=1
# 1 = 既有測試檔被刪減（@Test / 斷言變少、新增 @Disabled）時只警告（預設該輪 FAIL 餵回）
#UT_ALLOW_TEST_SHRINK=1
# generated = 迭代期間只跑目標類別的測試，通過前再完整重跑一次驗收（既有測試多時大幅加速）
#UT_TEST_SCOPE=generated
# 每輪餵回 writer 的失敗報告字元上限（context 吃緊時調小）
#UT_MAX_FEEDBACK_CHARS=12000
# 失敗報告中最多引用幾個失敗測試類別的 surefire 明細
#UT_MAX_FAILURE_BLOCKS=5
# 每個失敗測試類別最多引用幾個失敗案例（@Nested 一次可能失敗數十個）
#UT_MAX_FAILURE_CASES=10
# 0 = 允許 reviewer 未呼叫任何工具就輸出判決（預設 fail-closed 擋下）
#UT_REVIEWER_MUST_READ=0
# 六維分數門檻局部覆蓋（JSON，0-10 制，預設 7/7/7/6/7/6）
#UT_SCORE_THRESHOLDS={"readability":6}

# 行為開關
# reviewer 輸出解析不出判決時，額外重試幾次（預設 2）。解析失敗是 reviewer 的問題不是測試的
# 問題，writer 改測試碼不會讓它吐出合法 JSON，所以重試在 reviewer 這端，不花 writer 輪數。
#UT_REVIEW_MAX_RETRIES=2
#UT_SKIP_REVIEW=1
#UT_QUIET=1
#UT_SKIP_GUARD=1
# 單輪 agent 逾時（毫秒，預設 15 分鐘）
#UT_AGENT_TIMEOUT_MS=900000
# opencode 執行檔路徑（不在 PATH 時）
#UT_OPENCODE_BIN=opencode
# 0 = 不加 --format json（舊版 opencode 不支援 JSONL 事件時的退路）
#UT_OPENCODE_JSON=0
# 1 = writer 附加 --dangerously-skip-permissions（非互動被 permission 擋住寫檔時的最後手段）
#UT_OC_SKIP_PERMS=1

# 路徑覆蓋（UT_SKILL_DIR 未設時：目標 repo .opencode/.claude → 工具內建）
#UT_STANDARDS_PATH=
#UT_SKILL_DIR=
#UT_JACOCO_XML=
# 額外 maven 參數，例如 report 未綁 test phase 時：
#UT_MAVEN_ARGS=jacoco:report

# ---- UT_RUNNER=api：直接打 OpenAI-compatible endpoint，不需要 opencode ----
#UT_RUNNER=api
#UT_API_BASE_URL=http://localhost:11434/v1
#UT_API_KEY=
#UT_API_MAX_TURNS=60
#UT_API_MAX_TOKENS=8192
#UT_API_MAX_TOOL_RESULT_CHARS=24000
# 模型端暫時故障時持續重試多久（毫秒）。api runner：端點回應過之後，連線錯誤 / 429 / 5xx；
# opencode runner：agent 完成過 session 之後，opencode 異常結束就重新執行。模型伺服器重啟或閘道
# 短暫過載通常一兩分鐘內恢復；0 = 不重試，大於 0 至少重試一次。端點從未回應過（api 只快速試 3 次）或
# agent 從未做過事（opencode 不重新執行）時不適用，直接判定設定錯誤（多半是網址、proxy 或模型名稱設錯）。
#UT_AGENT_RETRY_WINDOW_MS=180000
#UT_WRITER_TEMPERATURE=0.2

# ---- UT_RUNNER=qwen 才需要（@qwen-code/sdk 走 OpenAI 相容協定）----
#OPENAI_API_KEY=
#OPENAI_BASE_URL=

# Build/test gate 逾時（毫秒，預設 30 分鐘）。逾時會終止整棵程序樹。
#UT_BUILD_TIMEOUT_MS=1800000
# 建置輸出在記憶體保留的字元上限（預設 64M）。超過時只留尾端與錯誤行；測試大量輸出 log 的模組
# 先前會在這裡撐爆 V8 字串上限，整個工具中途崩潰。
#UT_MAX_BUILD_OUTPUT_CHARS=67108864

# artifacts 落點覆蓋（共用或唯讀安裝時使用；預設寫在工具 clone 的 runs/ 下）
#UT_RUNS_DIR=

# --- 公司網路：proxy 與 TLS 攔截 ---------------------------------------------
# Node 的 fetch 不吃 HTTPS_PROXY（curl / git / mvn 都吃），所以本工具自己讀。
# UT_ 前綴會蓋過 shell 既有的同名變數；沒設就用標準變數。
#UT_HTTPS_PROXY=http://user:pass@proxy.corp:8080
#UT_HTTP_PROXY=http://proxy.corp:8080
# 繞過 proxy 的主機。內網的模型端點一定要列進來，而且要帶連接埠。
#UT_NO_PROXY=localhost,127.0.0.1,llm.corp:8080
# TLS 被攔截時要額外信任的 CA（PEM，可逗號分隔多個）。
# 比 NODE_EXTRA_CA_CERTS 可靠：後者只在 node 啟動前就 export 才有效。
#UT_CA_CERTS=/etc/ssl/corp-root.pem
# 某些 proxy 會依 User-Agent 過濾 CONNECT。
#UT_USER_AGENT=
